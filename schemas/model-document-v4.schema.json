{
  "$id": "prismpm/model-document/4",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserApplicationDeclaration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "application": {
      "$ref": "#/$defs/application"
    },
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "schema": {
      "const": "prismpm/model-document/4"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "standards_profile": {
      "oneOf": [
        {
          "const": []
        },
        {
          "const": [
            "ISO-25010-2023",
            "ISO-27005-2022",
            "ISO-27034-1-2011",
            "ISO-27034-5-2017",
            "ISO-42010-2022"
          ]
        }
      ]
    }
  },
  "required": [
    "application",
    "architecture",
    "provenance",
    "quality",
    "schema",
    "security",
    "standards_profile"
  ],
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "prismpm/browser-application/1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cargo_name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        "cargo_version": {
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "type": "string"
        },
        "cargo_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "cargo_repository": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string",
          "maxLength": 2048
        },
        "cargo_homepage": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string",
          "maxLength": 2048
        },
        "library_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
          }
        },
        "acceptance_vectors": {
          "items": {
            "$ref": "#/$defs/application_acceptance_vector"
          },
          "minItems": 1,
          "type": "array",
          "maxItems": 256
        },
        "entry_root": {
          "type": "string",
          "maxLength": 1024,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
        },
        "core_contract": {
          "const": "hologram:guest/core-wasm@1"
        },
        "request_maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "response_maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "guest_allocation_maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "capabilities_empty": {
          "const": true
        },
        "fat_archive": {
          "const": true
        },
        "primary_layer": {
          "const": 0
        },
        "view_layer": {
          "const": 1
        },
        "view": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "surface": {
              "const": "prismpm-browser/1"
            },
            "protocol": {
              "const": "prismpm/browser-presentation/1"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "heading": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "presentation_root": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "labels": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  }
                },
                "required": [
                  "id",
                  "text"
                ]
              }
            }
          },
          "required": [
            "surface",
            "protocol",
            "title",
            "heading",
            "presentation_root",
            "maximum",
            "labels"
          ]
        },
        "memory_pages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "protocol": {
          "const": "prismpm/browser-application-session/1"
        },
        "requested_effects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "adapter": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "guest"
                      },
                      "entry_root": {
                        "type": "string",
                        "maxLength": 1024,
                        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
                      },
                      "protocol": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "input_maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2097152
                      },
                      "output_maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2097152
                      },
                      "memory_pages": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16384
                      }
                    },
                    "required": [
                      "kind",
                      "entry_root",
                      "protocol",
                      "input_maximum",
                      "output_maximum",
                      "memory_pages"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "random"
                      },
                      "maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65536
                      }
                    },
                    "required": [
                      "kind",
                      "maximum"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "digest"
                      },
                      "maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      }
                    },
                    "required": [
                      "kind",
                      "maximum"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "sign"
                      },
                      "credential_slot": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                      },
                      "context": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
                        "not": {
                          "pattern": "\\.\\.|[^A-Za-z0-9._/-]"
                        }
                      },
                      "maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      }
                    },
                    "required": [
                      "kind",
                      "credential_slot",
                      "context",
                      "maximum"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "verify"
                      },
                      "context": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
                        "not": {
                          "pattern": "\\.\\.|[^A-Za-z0-9._/-]"
                        }
                      },
                      "maximum": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      }
                    },
                    "required": [
                      "kind",
                      "context",
                      "maximum"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "kind": {
                        "const": "store"
                      },
                      "namespace": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                      },
                      "max_object_bytes": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1048576
                      },
                      "max_objects": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4096
                      },
                      "max_heads": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 64
                      }
                    },
                    "required": [
                      "kind",
                      "namespace",
                      "max_object_bytes",
                      "max_objects",
                      "max_heads"
                    ]
                  }
                ]
              }
            },
            "required": [
              "resource",
              "adapter"
            ]
          }
        },
        "durability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "prismpm/browser-operation-journal/1"
            },
            "resource": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "head": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "replay_root": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
            },
            "max_pending": {
              "const": 1
            },
            "namespace": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "staging_head": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "signing_resource": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "credential_slot": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "maximum_records": {
              "type": "integer",
              "minimum": 2,
              "maximum": 1024
            }
          },
          "required": [
            "protocol",
            "resource",
            "head",
            "replay_root",
            "max_pending",
            "namespace",
            "staging_head",
            "signing_resource",
            "credential_slot",
            "maximum_records"
          ]
        }
      },
      "required": [
        "profile",
        "name",
        "cargo_name",
        "cargo_version",
        "cargo_description",
        "cargo_repository",
        "cargo_homepage",
        "library_roots",
        "acceptance_vectors",
        "entry_root",
        "core_contract",
        "request_maximum",
        "response_maximum",
        "guest_allocation_maximum",
        "capabilities_empty",
        "fat_archive",
        "primary_layer",
        "view_layer",
        "view",
        "memory_pages",
        "protocol",
        "requested_effects",
        "durability"
      ]
    },
    "application_acceptance_vector": {
      "additionalProperties": false,
      "properties": {
        "request": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array",
          "maxItems": 24576
        },
        "response": {
          "items": {
            "maximum": 255,
            "minimum": 0,
            "type": "integer"
          },
          "type": "array",
          "maxItems": 24576
        }
      },
      "required": [
        "request",
        "response"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "compiler_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "emitter_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "facet_packages": {
          "items": {
            "$ref": "#/$defs/facet"
          },
          "maxItems": 3,
          "type": "array"
        },
        "semantic_id": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_id": {
          "$ref": "#/$defs/sha256"
        },
        "source_id": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "compiler_semantics_id",
        "emitter_semantics_id",
        "facet_packages",
        "semantic_id",
        "snapshot_id",
        "source_id"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "activity": {
      "additionalProperties": false,
      "properties": {
        "control_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "control_index",
        "id",
        "index"
      ],
      "type": "object"
    },
    "architecture": {
      "additionalProperties": false,
      "properties": {
        "component_kinds": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/component"
          },
          "type": "array"
        },
        "concerns": {
          "items": {
            "$ref": "#/$defs/described"
          },
          "type": "array"
        },
        "edge_kinds": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/edge"
          },
          "type": "array"
        },
        "model_kinds": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "stakeholders": {
          "items": {
            "$ref": "#/$defs/described"
          },
          "type": "array"
        },
        "viewpoints": {
          "items": {
            "$ref": "#/$defs/viewpoint"
          },
          "type": "array"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/view"
          },
          "type": "array"
        }
      },
      "required": [
        "component_kinds",
        "components",
        "concerns",
        "edge_kinds",
        "edges",
        "model_kinds",
        "stakeholders",
        "viewpoints",
        "views"
      ],
      "type": "object"
    },
    "asset": {
      "additionalProperties": false,
      "properties": {
        "component_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "component_index",
        "id",
        "index"
      ],
      "type": "object"
    },
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index"
      ],
      "type": "object"
    },
    "component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "kind_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "required": [
        "id",
        "index",
        "kind_id"
      ],
      "type": "object"
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "risk_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index",
        "risk_index"
      ],
      "type": "object"
    },
    "described": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "required": [
        "id",
        "index"
      ]
    },
    "edge": {
      "additionalProperties": false,
      "properties": {
        "from_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "kind_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "to_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "from_index",
        "id",
        "index",
        "kind_id",
        "to_index"
      ],
      "type": "object"
    },
    "facet": {
      "additionalProperties": false,
      "properties": {
        "content_id": {
          "$ref": "#/$defs/sha256"
        },
        "package": {
          "enum": [
            "prism.arch",
            "prism.qual",
            "prism.sec"
          ]
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "content_id",
        "package",
        "version"
      ],
      "type": "object"
    },
    "index": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "indexed": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index"
      ],
      "type": "object"
    },
    "measure": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "requirement_index": {
          "$ref": "#/$defs/index"
        },
        "threshold": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index",
        "requirement_index",
        "threshold"
      ],
      "type": "object"
    },
    "measurement": {
      "additionalProperties": false,
      "properties": {
        "control_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "control_index",
        "id",
        "index",
        "passed"
      ],
      "type": "object"
    },
    "qualified_catalog": {
      "pattern": "^prism\\.(arch|qual|sec)@1\\.0\\.0::[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$",
      "type": "string"
    },
    "qualified_entity": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.]*::[A-Za-z][A-Za-z0-9_]*$",
      "type": "string"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "characteristics": {
          "items": {
            "$ref": "#/$defs/indexed"
          },
          "type": "array"
        },
        "measures": {
          "items": {
            "$ref": "#/$defs/measure"
          },
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "type": "array"
        },
        "subcharacteristics": {
          "items": {
            "$ref": "#/$defs/subcharacteristic"
          },
          "type": "array"
        }
      },
      "required": [
        "characteristics",
        "measures",
        "requirements",
        "subcharacteristics"
      ],
      "type": "object"
    },
    "requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "subcharacteristic_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index",
        "subcharacteristic_index"
      ],
      "type": "object"
    },
    "risk": {
      "additionalProperties": false,
      "properties": {
        "asset_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "impact_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "likelihood_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "threat_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "asset_index",
        "id",
        "impact_id",
