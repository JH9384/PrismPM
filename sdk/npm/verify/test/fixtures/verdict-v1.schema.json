{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.uor.foundation/prism/verdict/1",
  "title": "Verdict",
  "description": "The result of prism check, holo.verify() and @prism-code/verify. The level is computed from the evidence in the holo; the policy decides passed and never changes the level. Design: docs/proposals/269-assurance-levels.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "holo", "level", "policy", "passed", "reasons"],
  "properties": {
    "schema": { "const": "prism/verdict/1" },
    "holo": {
      "description": "The archive fingerprint of the holo that was checked.",
      "type": "string",
      "pattern": "^blake3:[0-9a-f]{64}$"
    },
    "level": { "$ref": "#/$defs/level" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "minimum"],
      "properties": {
        "name": {
          "description": "default, or the policy file as given to --policy.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "minimum": { "$ref": "#/$defs/level" }
      }
    },
    "passed": { "type": "boolean" },
    "reasons": {
      "description": "Every check that did not pass, in evaluation order.",
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/reason" }
    }
  },
  "allOf": [
    {
      "description": "A verdict passes only at or above its policy minimum.",
      "anyOf": [
        { "properties": { "passed": { "const": false } } },
        { "properties": { "policy": { "properties": { "minimum": { "const": "P0" } } } } },
        { "properties": { "policy": { "properties": { "minimum": { "const": "P1" } } }, "level": { "enum": ["P1", "P2", "P3"] } } },
        { "properties": { "policy": { "properties": { "minimum": { "const": "P2" } } }, "level": { "enum": ["P2", "P3"] } } },
        { "properties": { "policy": { "properties": { "minimum": { "const": "P3" } } }, "level": { "const": "P3" } } }
      ]
    },
    {
      "description": "The level is the highest one no reason withholds: below P3, some reason withholds the next level, and no reason withholds the level itself or one below it.",
      "anyOf": [
        {
          "properties": { "level": { "const": "P0" } },
          "not": { "properties": { "reasons": { "items": { "properties": { "withholds": { "not": { "const": "P1" } } } } } } }
        },
        {
          "properties": {
            "level": { "const": "P1" },
            "reasons": { "items": { "properties": { "withholds": { "enum": ["P2", "P3", null] } } } }
          },
          "not": { "properties": { "reasons": { "items": { "properties": { "withholds": { "not": { "const": "P2" } } } } } } }
        },
        {
          "properties": {
            "level": { "const": "P2" },
            "reasons": { "items": { "properties": { "withholds": { "enum": ["P3", null] } } } }
          },
          "not": { "properties": { "reasons": { "items": { "properties": { "withholds": { "not": { "const": "P3" } } } } } } }
        },
        {
          "properties": {
            "level": { "const": "P3" },
            "reasons": { "items": { "properties": { "withholds": { "const": null } } } }
          }
        }
      ]
    }
  ],
  "$defs": {
    "level": {
      "description": "P0 unverified, P1 provenance, P2 proof checked, P3 proof, replay and world.",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "withholds", "message"],
      "properties": {
        "check": {
          "description": "Stable dotted check id, for example proof.subject or policy.level.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*([.][a-z][a-z0-9-]*)+$"
        },
        "code": {
          "description": "The registered diagnostic, when one exists.",
          "type": "string",
          "pattern": "^PP[0-9]{4}$"
        },
        "withholds": {
          "description": "The lowest level this failure withholds, or null when it withholds none.",
          "enum": ["P1", "P2", "P3", null]
        },
        "message": {
          "description": "One plain sentence for a person. Not part of the contract.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
