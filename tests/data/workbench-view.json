          "expected_response": "{\"version\":1,\"status\":\"ok\",\"operation\":\"echo\",\"message\":\"Exact result computed.\",\"rows\":1,\"columns\":1,\"cells\":[\"world\"],\"details\":[\"The source dispatcher owns this exact response.\"],\"request\":\"world\",\"response\":\"world\",\"error\":\"\"}",
