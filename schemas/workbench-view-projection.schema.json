{
  "$id": "prismpm/workbench-view-projection/1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-bound Text/3 workbench asset projection",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "prismpm/workbench-view-projection/1"
    },
    "profile": {
      "const": "prism.workbench-view/1"
    },
    "model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "view_model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_core_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "max_input_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "max_output_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "browser_adapter": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "hologram_bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "projections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "target": {
            "enum": [
              "browser-wasm-bindgen",
              "hologram-intent-v1"
            ]
          },
          "files": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          }
        },
        "required": [
          "target",
          "files"
        ]
      }
    }
  },
  "required": [
    "schema",
    "profile",
    "model_id",
    "view_model_id",
    "generated_core_sha256",
    "max_input_bytes",
    "max_output_bytes",
    "browser_adapter",
    "hologram_bundle",
    "projections"
  ]
}
