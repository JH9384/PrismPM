{
  "$id": "https://schemas.uor.foundation/prismpm/system-model/2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "prismpm/system-model/2"
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{0,127}$"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lifecycle": {
          "enum": [
            "development",
            "candidate",
            "accepted",
            "retired"
          ]
        },
        "source_policy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "supported_platforms": {
          "const": [
            "browser"
          ]
        }
      },
      "required": [
        "id",
        "owner",
        "version",
        "lifecycle",
        "source_policy",
        "supported_platforms"
      ]
    },
    "application_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "prismpm/browser-resident-application/1"
        },
        "application_model_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution": {
          "const": "browser-session"
        },
        "persistent_storage": {
          "const": "none"
        },
        "external_services": {
          "const": "none"
        },
        "resources": {
          "const": [
            "dom",
            "webassembly"
          ]
        },
        "capabilities": {
          "const": [
            "portable-static-holo-application"
          ]
        }
      },
      "required": [
        "contract",
        "application_model_digest",
        "execution",
        "persistent_storage",
        "external_services",
        "resources",
        "capabilities"
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            "artifact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            "kind": {
              "const": "browser"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "artifact",
            "kind",
            "version"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            "artifact": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            "kind": {
              "const": "cli"
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "id",
            "artifact",
            "kind",
            "version"
          ]
        }
      ],
      "items": false
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            "role": {
              "const": "selected-application"
            },
            "license_expression": {
              "const": "MIT OR Apache-2.0"
            }
          },
          "required": [
            "id",
            "role",
            "license_expression"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9.-]{0,127}$"
            },
            "role": {
              "const": "command-line-program"
            },
            "license_expression": {
              "const": "MIT OR Apache-2.0"
            }
          },
          "required": [
            "id",
            "role",
            "license_expression"
          ]
        }
      ],
      "items": false
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,127}$"
          },
          "kind": {
            "const": "github-pages-browser"
          },
          "adapter_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "api_version": {
            "const": "github-pages-artifact@v4"
          },
          "minimum_release_status": {
            "enum": [
              "development",
              "candidate",
              "accepted"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "adapter_digest",
          "api_version",
          "minimum_release_status"
        ]
      }
    },
    "controls": {
      "const": [
        "application-acceptance",
        "artifact-closure",
        "source-proof",
        "spdx"
      ]
    },
    "standards": {
      "const": [
        "SPDX-3.0.1"
      ]
    }
  },
  "required": [
    "schema",
    "product",
    "application_profile",
    "components",
    "artifacts",
    "targets",
    "controls",
    "standards"
  ]
}
