; Private DK-30 metadata; canonical definite CBOR, all input consumed.
; Position/receipt fields are generated projections, never authentication facts.
uint32 = 0..4294967295
reference = bstr .size 32
source-binding = [reference, reference, reference, reference, reference, reference]
binding = [source-binding, instance: reference, origin: reference,
  signing-key: bstr .size 65, signing-context: tstr, namespace: tstr,
  journal-head: tstr, staging-head: tstr, maximum-records: 2..1024,
  witness-policy: reference]
; Existing effect signing/store-name grammars; heads differ; key starts with 4.
payload = [digest: reference, length: 1..67108864, chunks: [1*64 reference]]
; DK-24 exact ordered coverage: each nonfinal chunk 1 MiB; last 1..1 MiB.
envelope = payload
; Signed envelope descriptor length <=65536, not self-referential.
optional-payload = [0] / [1, payload]
step = [command: 0..4294967294, step: 1..512, maximum-steps: 1..512]
; step <= maximum-steps; command+1 = position.next-command.
optional-step = [0] / [1, step]
position = [successor: payload, authority-epoch: uint32, phase: 0..3,
  next-command: uint32, pending: optional-step]
; Ready0 has no pending; Busy1 and Unknown2 require pending; Closed3 retains it.
anchor = [prepared-envelope: envelope, prepared-position: position, step,
  observed-receipt: optional-payload]
optional-anchor = [0] / [1, anchor]
recovery-plan = [prepared-envelope: envelope, context-digest: reference,
  settle-before: position, settle-operation: payload, settled: position,
  rebind-operation: payload, actual-terminal-receipt: payload]
optional-recovery = [0] / [1, recovery-plan]
record = [binding, genesis: reference, sequence: 1..4294967295,
  previous: reference, kind: 1..10, before: position, operation: payload,
  after: position, actual-receipt: optional-payload, frontier: optional-payload,
  recovery: optional-recovery]
; Kind0 Genesis is separate initialization, not append.
; 1 ReadOnly, 2 Prepared, 3 Settled, 4 ContinuedPrepared, 5 Unknown,
; 6 Closed, 7 Rebound, 8 RecoveryReady, 9 RecoveryTerminal, 10 Checkpoint.
; Tags8/9 belong to this journal protocol, not DK-26 ContextCheck.
; Kinds3/4/5/9 require actual-receipt; other kinds forbid it.
; Only Checkpoint requires frontier. Its before/after positions match exactly.
; Only RecoveryTerminal requires recovery-plan. Its exact Prepared envelope
; and position match the retained anchor. Actual generated projections bind
; each separate settle/rebind frame and current/Prepared context digest.
state = [binding, genesis: reference, sequence: uint32, head: reference,
  retained: 0..1024, position, optional-anchor]
entry = [record, envelope]
request = [1, 0, binding, initialize-operation: payload, position, envelope]
        / [1, 1, state, record, envelope]
        / [1, 2, state, [*1024 entry]]
        / [1, 3, state]
        / [1, 4, record]
        / [1, 5, position]
response = [1, 0, (state / bool)]
         / [1, 1, metadata-error: 0..17]
         / [1, 2, cbor-error: 0..8]
; Error order: BadBinding, BadPayload, BadPosition, BadAnchor, BadState,
; BadRecord, BindingChanged, GenesisMismatch, SequenceMismatch,
; PredecessorMismatch, BeforeMismatch, TransitionMismatch, EpochMismatch,
; RecordLimit, CounterExhausted, ReceiptMismatch, FrontierMismatch,
; EnvelopeMismatch. Reserved distinctions are not separate authority grants.
; All actual payload/signature/projection/witness/frontier/storage checks in
; SessionJournal.md are nonoptional composition obligations.
