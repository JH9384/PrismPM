{
  "$id": "prismpm/model-document/8",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeLibraryFacetModelDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "architecture",
    "library",
    "provenance",
    "quality",
    "schema",
    "security",
    "standards_profile"
  ],
  "properties": {
    "architecture": {
      "$ref": "#/$defs/architecture"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "schema": {
      "const": "prismpm/model-document/8"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "standards_profile": {
      "const": [
        "ISO-25010-2023",
        "ISO-27005-2022",
        "ISO-27034-1-2011",
        "ISO-27034-5-2017",
        "ISO-42010-2022"
      ]
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "name",
        "cargo_name",
        "cargo_version",
        "cargo_description",
        "cargo_repository",
        "cargo_homepage",
        "export_roots",
        "acceptance_roots"
      ],
      "properties": {
        "profile": {
          "const": "prismpm/native-library/1"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "cargo_name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "cargo_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "cargo_description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "cargo_repository": {
          "$ref": "#/$defs/https"
        },
        "cargo_homepage": {
          "$ref": "#/$defs/https"
        },
        "export_roots": {
          "$ref": "#/$defs/roots"
        },
        "acceptance_roots": {
          "$ref": "#/$defs/roots"
        }
      }
    }
  },
  "$defs": {
    "activity": {
      "additionalProperties": false,
      "properties": {
        "control_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "control_index",
        "id",
        "index"
      ],
      "type": "object"
    },
    "architecture": {
      "additionalProperties": false,
      "properties": {
        "component_kinds": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/component"
          },
          "type": "array"
        },
        "concerns": {
          "items": {
            "$ref": "#/$defs/described"
          },
          "type": "array"
        },
        "edge_kinds": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/edge"
          },
          "type": "array"
        },
        "model_kinds": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "stakeholders": {
          "items": {
            "$ref": "#/$defs/described"
          },
          "type": "array"
        },
        "viewpoints": {
          "items": {
            "$ref": "#/$defs/viewpoint"
          },
          "type": "array"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/view"
          },
          "type": "array"
        }
      },
      "required": [
        "component_kinds",
        "components",
        "concerns",
        "edge_kinds",
        "edges",
        "model_kinds",
        "stakeholders",
        "viewpoints",
        "views"
      ],
      "type": "object"
    },
    "asset": {
      "additionalProperties": false,
      "properties": {
        "component_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "component_index",
        "id",
        "index"
      ],
      "type": "object"
    },
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index"
      ],
      "type": "object"
    },
    "component": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "kind_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "required": [
        "id",
        "index",
        "kind_id"
      ],
      "type": "object"
    },
    "control": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "risk_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index",
        "risk_index"
      ],
      "type": "object"
    },
    "described": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
        },
        "text": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f]*$"
        }
      },
      "required": [
        "id",
        "index"
      ],
      "type": "object"
    },
    "edge": {
      "additionalProperties": false,
      "properties": {
        "from_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "kind_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "to_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "from_index",
        "id",
        "index",
        "kind_id",
        "to_index"
      ],
      "type": "object"
    },
    "facet": {
      "additionalProperties": false,
      "properties": {
        "content_id": {
          "$ref": "#/$defs/sha256"
        },
        "package": {
          "enum": [
            "prism.arch",
            "prism.qual",
            "prism.sec"
          ]
        },
        "version": {
          "const": "1.0.0"
        }
      },
      "required": [
        "content_id",
        "package",
        "version"
      ],
      "type": "object"
    },
    "index": {
      "maximum": 18446744073709551615,
      "minimum": 0,
      "type": "integer"
    },
    "indexed": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index"
      ],
      "type": "object"
    },
    "measure": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "requirement_index": {
          "$ref": "#/$defs/index"
        },
        "threshold": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index",
        "requirement_index",
        "threshold"
      ],
      "type": "object"
    },
    "measurement": {
      "additionalProperties": false,
      "properties": {
        "control_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "control_index",
        "id",
        "index",
        "passed"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "compiler_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "emitter_semantics_id": {
          "$ref": "#/$defs/sha256"
        },
        "facet_packages": {
          "items": {
            "$ref": "#/$defs/facet"
          },
          "maxItems": 3,
          "type": "array"
        },
        "semantic_id": {
          "$ref": "#/$defs/sha256"
        },
        "snapshot_id": {
          "$ref": "#/$defs/sha256"
        },
        "source_id": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "compiler_semantics_id",
        "emitter_semantics_id",
        "facet_packages",
        "semantic_id",
        "snapshot_id",
        "source_id"
      ],
      "type": "object"
    },
    "quality": {
      "additionalProperties": false,
      "properties": {
        "characteristics": {
          "items": {
            "$ref": "#/$defs/indexed"
          },
          "type": "array"
        },
        "measures": {
          "items": {
            "$ref": "#/$defs/measure"
          },
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/requirement"
          },
          "type": "array"
        },
        "subcharacteristics": {
          "items": {
            "$ref": "#/$defs/subcharacteristic"
          },
          "type": "array"
        }
      },
      "required": [
        "characteristics",
        "measures",
        "requirements",
        "subcharacteristics"
      ],
      "type": "object"
    },
    "qualified_catalog": {
      "pattern": "^prism\\.(arch|qual|sec)@1\\.0\\.0::[A-Za-z][A-Za-z0-9_]*\\.[A-Za-z][A-Za-z0-9_]*$",
      "type": "string"
    },
    "qualified_entity": {
      "pattern": "^[A-Za-z][A-Za-z0-9_.]*::[A-Za-z][A-Za-z0-9_]*$",
      "type": "string"
    },
    "requirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "subcharacteristic_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index",
        "subcharacteristic_index"
      ],
      "type": "object"
    },
    "risk": {
      "additionalProperties": false,
      "properties": {
        "asset_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "impact_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "likelihood_id": {
          "$ref": "#/$defs/qualified_catalog"
        },
        "threat_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "asset_index",
        "id",
        "impact_id",
        "index",
        "likelihood_id",
        "threat_index"
      ],
      "type": "object"
    },
    "security": {
      "additionalProperties": false,
      "properties": {
        "activities": {
          "items": {
            "$ref": "#/$defs/activity"
          },
          "type": "array"
        },
        "assets": {
          "items": {
            "$ref": "#/$defs/asset"
          },
          "type": "array"
        },
        "controls": {
          "items": {
            "$ref": "#/$defs/control"
          },
          "type": "array"
        },
        "impacts": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "likelihoods": {
          "items": {
            "$ref": "#/$defs/catalog"
          },
          "type": "array"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/measurement"
          },
          "type": "array"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/risk"
          },
          "type": "array"
        },
        "threats": {
          "items": {
            "$ref": "#/$defs/indexed"
          },
          "type": "array"
        }
      },
      "required": [
        "activities",
        "assets",
        "controls",
        "impacts",
        "likelihoods",
        "measurements",
        "risks",
        "threats"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "subcharacteristic": {
      "additionalProperties": false,
      "properties": {
        "characteristic_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "characteristic_index",
        "id",
        "index"
      ],
      "type": "object"
    },
    "view": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "model_kind_index": {
          "$ref": "#/$defs/index"
        },
        "viewpoint_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "id",
        "index",
        "model_kind_index",
        "viewpoint_index"
      ],
      "type": "object"
    },
    "viewpoint": {
      "additionalProperties": false,
      "properties": {
        "concern_index": {
          "$ref": "#/$defs/index"
        },
        "id": {
          "$ref": "#/$defs/qualified_entity"
        },
        "index": {
          "$ref": "#/$defs/index"
        },
        "model_kind_index": {
          "$ref": "#/$defs/index"
        },
        "stakeholder_index": {
          "$ref": "#/$defs/index"
        }
      },
      "required": [
        "concern_index",
        "id",
        "index",
        "model_kind_index",
        "stakeholder_index"
      ],
      "type": "object"
    },
    "https": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "maxLength": 2048
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 1024,
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
      }
    }
  }
}
