; Private deterministic CBOR test/SDK boundary; no account authority.
request = [1, 0, bstr .size (0..480)]
        / [1, 1..3, bstr .size (0..64), bstr .size (0..64)]
        / [1, 4, [* 0..17 uint .le 4294967295]]
success = [1, 0, bool / bstr .size 32]
failure = [1, 1, 0..1] / [1, 2, 0..8]
; 0 point validity, 1 field addition, 2 field subtraction, 3 multiplication,
; 4 typed field invariant. Field operands must be exactly 32 bytes and < p.
; Exactly 17 limbs, each < 65536 with top zero and value < p, are valid.
; Source frame <=512 bytes; test allocator 1024 bytes admits malformed 513.
